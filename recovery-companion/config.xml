<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://tizenbrew.vercel.app/recovery-companion" version="1.1.0" viewmodes="maximized">
    <tizen:application id="TbRecov001.RecoveryCompanion" package="TbRecov001" required_version="3.0"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>TizenBrew Recovery</name>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <feature name="http://tizen.org/feature/web.service"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:service id="TbRecov001.RecoveryService">
        <tizen:content src="service/index.js"/>
        <tizen:name>TizenBrewRecoveryService</tizen:name>
        <tizen:description>Authenticated recovery for the separate TizenBrew package</tizen:description>
    </tizen:service>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="enable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
